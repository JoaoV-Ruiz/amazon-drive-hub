# ============================================================
# AmazonRepasse — Frontend (.env)
# ------------------------------------------------------------
# Copie este arquivo para `.env` e preencha os valores.
# NUNCA commitar o `.env` real (já está no .gitignore).
#
# Atenção: tudo que começa com VITE_ é EXPOSTO no bundle do
# navegador. Nunca coloque chaves secretas aqui — apenas a
# `anon key` do Supabase é segura no frontend.
# ============================================================

# ------- API ----------
VITE_API_URL=http://localhost:3333

# ------- Supabase (cliente) ----------------------------------
# Onde encontrar (Supabase Dashboard > Project Settings):
#   • VITE_SUPABASE_URL       → "Project Settings" → "API" → "Project URL"
#   • VITE_SUPABASE_ANON_KEY  → "Project Settings" → "API" → "Project API keys" → "anon public"
#
# NÃO use a service_role aqui. Nunca.
# -------------------------------------------------------------
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=cole-aqui-a-anon-public-key

# ------- WhatsApp ---------------------------------------------
# Número usado no botão "WhatsApp" do anúncio.
# Formato internacional, somente dígitos (ex.: 5592999999999).
# -------------------------------------------------------------
VITE_WHATSAPP_NUMBER=5592000000000
