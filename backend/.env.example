# ============================================================
# AmazonRepasse — Backend (.env)
# ------------------------------------------------------------
# Copie este arquivo para `.env` e preencha os valores.
# NUNCA commitar o `.env` real (já está no .gitignore).
# ============================================================

# ------- Servidor -------
PORT=3333
HOST=0.0.0.0
NODE_ENV=development

# ------- Supabase --------------------------------------------
# Onde encontrar (Supabase Dashboard > Project Settings):
#   • SUPABASE_URL              → "Project Settings" → "API" → "Project URL"
#   • SUPABASE_ANON_KEY         → "Project Settings" → "API" → "Project API keys" → "anon public"
#   • SUPABASE_SERVICE_ROLE_KEY → "Project Settings" → "API" → "Project API keys" → "service_role"
#
# ATENÇÃO: a SERVICE_ROLE_KEY ignora RLS. Use SOMENTE no backend.
#           Nunca exponha no frontend ou em logs.
# -------------------------------------------------------------
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=cole-aqui-a-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=cole-aqui-a-service-role-key

# ------- Autenticação -----------------------------------------
# Não precisamos de JWT_SECRET próprio.
# Os tokens são emitidos pelo Supabase Auth e validados no backend
# via supabase.auth.getUser(token) — ver src/middlewares/auth.ts.
# -------------------------------------------------------------

# ------- FIPE -------------------------------------------------
# API pública usada no cadastro de veículos (RN005).
# Pode manter o valor padrão.
# -------------------------------------------------------------
FIPE_API_URL=https://parallelum.com.br/fipe/api/v1
